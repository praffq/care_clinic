#!/sbin/openrc-run

name="care-engine-agent"
description="CARE engine agent"
supervisor="supervise-daemon"
command="/usr/bin/care-engine-agent"
output_log="/var/log/care-engine-agent.log"
error_log="/var/log/care-engine-agent.log"
respawn_delay=2

# Only "use" docker: /v1/status must keep answering (docker_ready=false)
# when dockerd fails so the host can diagnose it.
depend() {
	need net
	use docker
	after docker
}

start_pre() {
	local f=/var/lib/care/.data-schema supported current
	if [ ! -e "$f" ]; then
		eerror "FATAL: data schema file $f is missing (data disk not initialised by care-init); refusing to start"
		return 1
	fi
	current=$(cat "$f" 2>/dev/null)
	supported=$(cat /etc/care-engine/data-schema)
	case "$current" in
	'')
		eerror "FATAL: data schema file $f is empty although the data disk is initialised (interrupted first boot or corruption); refusing to start, data left untouched"
		return 1
		;;
	*[!0-9]*)
		eerror "FATAL: data schema file $f is invalid ('$current'); refusing to start, data left untouched"
		return 1
		;;
	esac
	if [ "$current" -gt "$supported" ]; then
		eerror "data disk schema $current is newer than this engine supports ($supported); refusing to start. Upgrade the CARE engine."
		return 1
	fi
}
