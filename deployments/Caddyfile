{
	auto_https disable_redirects
	order coraza_waf first

	# Every connection arrives through the engine's port relay, which sends a
	# PROXY v2 header with the real client address. Docker's port proxy makes
	# it come from the pinned network gateway; anything else is rejected.
	servers :443 {
		listener_wrappers {
			proxy_protocol {
				allow 172.30.0.1/32
				fallback_policy reject
			}
			tls
		}
		protocols h1 h2
	}

	servers :80 {
		listener_wrappers {
			proxy_protocol {
				allow 172.30.0.1/32
				fallback_policy reject
			}
		}
		protocols h1 h2
	}

	# Home access (Tailscale serve) also sets X-Forwarded-For.
	servers :8480 {
		listener_wrappers {
			proxy_protocol {
				allow 172.30.0.1/32
				fallback_policy reject
			}
		}
		protocols h1 h2
		trusted_proxies static private_ranges
	}

	pki {
		ca local {
			name "CARE Clinic"
			root_cn "CARE Clinic Local CA"
			intermediate_cn "CARE Clinic Local CA - Intermediate"
		}
	}
}

(bootstrap) {
	@mobileSetup path /setup /setup/
	handle @mobileSetup {
		root * /setup
		rewrite * /index.html
		templates
		file_server
	}

	handle /root.crt {
		header Content-Type application/x-x509-ca-cert
		root * /data/caddy/pki/authorities/local
		file_server
	}
}


(site) {
	log
	encode gzip

	header -Strict-Transport-Security

	handle /api/* {
		coraza_waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				Include @owasp_crs/*.conf
				Include /etc/caddy/waf-mode.conf
			`
		}
		reverse_proxy backend:9000
	}
	@backend path /static/* /ping/* /health/*
	handle @backend {
		reverse_proxy backend:9000
	}

	@buckets path /{$FILE_UPLOAD_BUCKET:patient-bucket}/* /{$FACILITY_S3_BUCKET:facility-bucket}/*
	handle @buckets {
		reverse_proxy minio:9000
	}

	handle {
		reverse_proxy frontend:80
	}
}

:80 {
	import bootstrap
	handle {
		redir https://{host}{uri} permanent
	}
}

{$CARE_HOST}:443 {
	tls internal
	import bootstrap
	import site
}

http://:8480 {
	request_header X-Forwarded-Proto https
	import site
}

localhost:443 {
	tls internal
	reverse_proxy /ping/* backend:9000
}
