# --- CARE engine (macOS and Windows) -----------------------------------------
# The Linux VM that runs Docker, built from vm/ by the fork's care-vm workflow and
# published as release assets under CARE_VM_BASE_URL (see docs/vm.md). The
# Windows QEMU and extraction tools are fetched directly from their publishers.
CARE_VM_VERSION=0.1.2
CARE_VM_BASE_URL=https://github.com/praffq/care_clinic/releases/download/care-engine-v0.1.2
