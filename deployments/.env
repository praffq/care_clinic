# Non-release Compose defaults. Every release version, image tag and download
# pin lives in versions.toml at the repository root; the build appends them to
# the .env embedded in the app (app/cmd/stageconfig). Do not add them here.

# --- Local image names the stack runs ----------------------------------------
BACKUP_IMAGE=care-backup:clinic
CADDY_WAF_IMAGE=care-caddy:clinic
BACKEND_IMAGE=care:clinic
FRONTEND_IMAGE=care_fe:clinic
