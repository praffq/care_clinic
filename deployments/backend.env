DJANGO_SETTINGS_MODULE=config.settings.production

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_HOST=db
POSTGRES_DB=care
POSTGRES_PORT=5432
# POSTGRES_PASSWORD and DATABASE_URL are in the generated secrets.env.

# --- Redis (cache + Celery queue) -------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0

# --- Django core ------------------------------------------------------------
# DJANGO_SECRET_KEY is in the generated secrets.env.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=["*"]
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_CONTENT_TYPE_NOSNIFF=False
# Sentry OFF: settings only init Sentry when SENTRY_DSN is non-empty.
SENTRY_DSN=
# CSRF_TRUSTED_ORIGINS, CORS_ALLOWED_ORIGINS and BUCKET_EXTERNAL_ENDPOINT are
# in the generated clinic.env, computed from every name the clinic is served on.

# --- Object storage (MinIO, S3-compatible) ----------------------------------
BUCKET_ENDPOINT=http://minio:9000
BUCKET_REGION=ap-south-1
# BUCKET_KEY and BUCKET_SECRET (= MINIO_ROOT_USER/PASSWORD) are in secrets.env.
FILE_UPLOAD_BUCKET=patient-bucket
FACILITY_S3_BUCKET=facility-bucket

# --- Email -----------------------------------------------------------------
# CARE Clinic sends no email. The dummy backend discards every message, so
# password-reset and account emails succeed without trying a mail server.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend

# --- SMS / OTP --------------------------------------------------------------
USE_SMS=False

SMS_BACKEND="care.utils.sms.backend.console.ConsoleBackend"

# --- Login rate limit -------------------------------------------------------
DISABLE_RATELIMIT=True

# --- Patient identifiers ----------------------------------------------------
# Keep searchable name and phone number identifiers on every patient.
MAINTAIN_PATIENT_NAME_IDENTIFIER=True
MAINTAIN_PATIENT_PHONE_NUMBER_IDENTIFIER=True

# --- Backups ----------------------------------------------------------------
# how many days backup you want to keep. 0 mean keep all
DB_BACKUP_RETENTION_PERIOD=14

# --- Reverse proxy WAF ------------------------------------------------------
# Off (inert) | DetectionOnly (evaluate + log, never block) | On (block with 403).
CORAZA_MODE=Off
